# Copy to .env and fill with FREE-tier keys (never commit .env)
# Alchemy (free): https://www.alchemy.com/ — tokens, NFTs, activity, prices
VITE_ALCHEMY_API_KEY=
# WalletConnect Cloud (free): https://cloud.walletconnect.com/ — dApp pairing
VITE_WALLETCONNECT_PROJECT_ID=
# 0x Swap API (free): https://0x.org/ — same-chain swaps
VITE_ZEROX_API_KEY=
# Cross-chain swaps use LI.FI (https://li.quest) — no key required.
